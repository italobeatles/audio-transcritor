# Copie este arquivo para .env e preencha somente localmente.
# Nunca suba chaves reais para o Git.

PORT=3000
HOST=127.0.0.1

# Transcricao local via Transformers.js
LOCAL_TRANSCRIPTION_MODEL=Xenova/whisper-tiny

# OpenAI
USE_OPENAI=true
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SUMMARY_MODEL=gpt-4.1-mini

# GitHub Models
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini
GITHUB_BASE_URL=https://models.inference.ai.azure.com

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024
COHERE_BASE_URL=https://api.cohere.com

# Hugging Face Inference Providers
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash:fastest
HF_BASE_URL=https://router.huggingface.co/v1
