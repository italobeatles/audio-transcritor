# Copie este arquivo para .env e preencha somente localmente.
# Nunca suba chaves reais para o Git.

PORT=3000
HOST=127.0.0.1

# Transcricao local via Transformers.js
LOCAL_TRANSCRIPTION_MODEL=Xenova/whisper-base

# Correcao automatica da transcricao com IA (true/false)
ENABLE_TRANSCRIPTION_CORRECTION=true

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Microsoft Foundry Models
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_ENDPOINT=https://<seu-projeto>.services.ai.azure.com/models

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Hugging Face Inference Providers
HF_TOKEN=
HF_MODEL=zai-org/GLM-4.5
HF_BASE_URL=https://router.huggingface.co/v1

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
COHERE_BASE_URL=https://api.cohere.com

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=zai-glm-4.7
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# OpenCode
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts

# BytePlus / ModelArk
BYTEPLUS_API_KEY=
ARK_API_KEY=
BYTEPLUS_MODEL=seed-1-8-251228
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# OpenAI
USE_OPENAI=true
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe
SUMMARY_MODEL=gpt-5-mini
PREFER_REMOTE_TRANSCRIPTION=true

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama (local - ultimo fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:0.5b
